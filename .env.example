# Banco Demo v1 — configuração local (copie para .env; nenhum segredo real)
HOST=127.0.0.1
PORT=3001
# Caminho do arquivo SQLite (nunca :memory: no app)
DATABASE_PATH=./data/bank.sqlite
# Origem do frontend aceita em mutações (sem path)
FRONTEND_ORIGIN=http://127.0.0.1:3000
# Secure do cookie: false apenas em HTTP local
COOKIE_SECURE=false
LOG_LEVEL=info
WORKER_POLL_INTERVAL_MS=200
# Controles de teste /__test: só com true E token com >= 16 caracteres
ENABLE_TEST_CONTROLS=false
TEST_CONTROL_TOKEN=
