# Executado com: process.loadEnvFile() no server.ts (stdlib Node 24). Copie para .env e ajuste.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/bank.sqlite
FRONTEND_ORIGIN=http://127.0.0.1:3000
# true em HTTPS; false apenas no HTTP local
COOKIE_SECURE=false
LOG_LEVEL=info
WORKER_POLL_INTERVAL_MS=200
# Controles /__test: só com flag true E token explícito (>=16 chars)
ENABLE_TEST_CONTROLS=false
TEST_CONTROL_TOKEN=
