{
  "description": "Banco Demo backend — Fastify + SQLite + CQRS + Saga",
  "engines": {
    "node": ">=24 <25"
  },
  "name": "banco-demo-backend",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:reset": "tsx src/db/cli.ts reset",
    "db:seed": "tsx src/db/cli.ts seed",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postbuild": "mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "openapi": "tsx scripts/build-openapi.ts"
  },
  "type": "module",
  "version": "1.0.0",
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "better-sqlite3": "12.4.1",
    "fastify": "5.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.7.2",
    "ajv": "8.17.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
