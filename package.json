{
  "name": "banco-demo-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend Banco Demo — CQRS + Saga persistida sobre SQLite (Fastify + TypeScript)",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
